# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments / secrets
.venv/
.env
.env.*

# VS Code local settings
.vscode/
!.vscode/extensions.json

# FERPA / student data exclusions
data/incoming/
data/working/
data/reviewed/
data/archive/
data/rejected/

# Generated outputs
*.log
*.tmp
*.bak
*.jsonl

# Scans, images, PDFs, and exports
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.pdf
*.csv
*.xlsx

# Keep folder placeholders
!.gitkeep

# Allow locked non-student JSON maps and markdown docs
!forms/LSCO_TDCJ_Application_v5_green/maps_locked/*.json
!forms/LSCO_TDCJ_Application_v5_green/maps_locked/*.md
!forms/LSCO_TDCJ_Application_v5_green/maps_derivatives/README.md

# Canonical PDFs/XLSX should stay local unless intentionally force-added.
